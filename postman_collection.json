{
  "info": {
    "name": "Analytics API",
    "description": "Complete API collection for Analytics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "app_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Google OAuth Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/google",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Initiate Google OAuth flow. Open this in a browser."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Register App",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('api_key', jsonData.data.apiKey);",
                  "    pm.collectionVariables.set('app_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Test App\",\n  \"domain\": \"https://myapp.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Get API Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/api-key?appId={{app_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "api-key"],
              "query": [
                {
                  "key": "appId",
                  "value": "{{app_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": \"{{app_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "revoke"]
            }
          }
        },
        {
          "name": "Regenerate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('api_key', jsonData.data.apiKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": \"{{app_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/regenerate",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "regenerate"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Collect Event",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"login_form_cta_click\",\n  \"url\": \"https://example.com/login\",\n  \"referrer\": \"https://google.com\",\n  \"device\": \"mobile\",\n  \"userId\": \"user123\",\n  \"timestamp\": \"2024-02-20T12:34:56Z\",\n  \"metadata\": {\n    \"browser\": \"Chrome\",\n    \"os\": \"Android\",\n    \"screenSize\": \"1080x1920\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analytics/collect",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics"],
              "path": ["api", "analytics", "collect"]
            }
          }
        },
        {
          "name": "Get Event Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/event-summary?event=login_form_cta_click&startDate=2024-01-01&endDate=2024-12-31",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "event-summary"],
              "query": [
                {
                  "key": "event",
                  "value": "login_form_cta_click"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "disabled": true
                },
                {
                  "key": "endDate",
                  "value": "2024-12-31",
                  "disabled": true
                },
                {
                  "key": "app_id",
                  "value": "{{app_id}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get User Stats",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/user-stats?userId=user123",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "user-stats"],
              "query": [
                {
                  "key": "userId",
                  "value": "user123"
                },
                {
                  "key": "app_id",
                  "value": "{{app_id}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Event Trends",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/event-trends?event=login_form_cta_click&interval=day",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "event-trends"],
              "query": [
                {
                  "key": "event",
                  "value": "login_form_cta_click"
                },
                {
                  "key": "interval",
                  "value": "day"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "disabled": true
                },
                {
                  "key": "endDate",
                  "value": "2024-12-31",
                  "disabled": true
                },
                {
                  "key": "app_id",
                  "value": "{{app_id}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Top Events",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/top-events/{{app_id}}?limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "top-events", "{{app_id}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Dashboard Overview",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/dashboard?app_id={{app_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "dashboard"],
              "query": [
                {
                  "key": "app_id",
                  "value": "{{app_id}}",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    }
  ]
}