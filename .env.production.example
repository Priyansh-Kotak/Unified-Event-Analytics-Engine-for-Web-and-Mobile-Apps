# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=analytics_production_db
DB_USER=analytics_user
DB_PASSWORD=your_super_secure_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security - IMPORTANT: Change these to strong random values
JWT_SECRET=your_jwt_secret_min_32_chars_random_string
SESSION_SECRET=your_session_secret_min_32_chars_random_string

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=https://your-frontend-domain.com

# Logging
LOG_LEVEL=info